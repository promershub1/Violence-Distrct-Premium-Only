        tab.Page = page; tab.Button = tabBtn; tab.Indicator = indicator; tab.Label = tabLabel
        table.insert(tabs, tab)
        tabBtn.MouseButton1Click:Connect(function()
            if window._destroyed then return end
            for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
            for _, t in ipairs(tabs) do
                t.Page.Visible = false
                tween(t.Button, {BackgroundColor3 = Library.Theme.Bg2}, 0.15)
                tween(t.Label, {TextColor3 = Library.Theme.Sub}, 0.15)
                tween(t.Indicator, {BackgroundTransparency = 1}, 0.15)
            end
