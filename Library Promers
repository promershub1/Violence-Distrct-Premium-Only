-- CONFIG SYSTEM (ROBUST)
local function configPath(name) return Library.ConfigPrefix .. name .. ".json" end
local function masterPath() return Library.ConfigPrefix .. "master.json" end
local function autoPath() return Library.ConfigPrefix .. "autoload.txt" end

local function sanitizeName(name)
    return tostring(name or "default"):gsub("[^%w_%-%. ]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
end

local function readMasterList()
    local result = {}
    if not readfile then return result end
    local path = masterPath()
    if isfile and not isfile(path) then return result end
    local ok, data = pcall(readfile, path)
    if not ok or not data or data == "" then return result end
    local decOk, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not decOk or type(decoded) ~= "table" then return result end
    if type(decoded.configs) == "table" then
        for _, n in ipairs(decoded.configs) do
            if type(n) == "string" then table.insert(result, n) end
        end
    end
    return result
end

local function writeMasterList(list)
    if not writefile then return false end
    local ok, encoded = pcall(function() return HttpService:JSONEncode({configs = list}) end)
    if not ok then return false end
    local wok = pcall(writefile, masterPath(), encoded)
    return wok
end

function Library:_trackConfig(name)
    name = sanitizeName(name)
    local list = readMasterList()
    for _, n in ipairs(list) do if n == name then return end end
    table.insert(list, name)
    writeMasterList(list)
end

function Library:_untrackConfig(name)
    name = sanitizeName(name)
    local list = readMasterList()
    for i, n in ipairs(list) do if n == name then table.remove(list, i); break end end
    writeMasterList(list)
end

function Library:GetConfigList()
    local list, seen = {}, {}
    if type(listfiles) == "function" then
        local ok, files = pcall(listfiles)
        if ok and type(files) == "table" then
            for _, file in ipairs(files) do
                local clean = tostring(file):gsub("\\", "/")
                local fname = clean:match("([^/]+)$") or clean
                local name = fname:match("^" .. Library.ConfigPrefix .. "(.+)%.json$")
                if name and name ~= "master" and not seen[name] then
                    seen[name] = true
                    table.insert(list, name)
                end
            end
        end
    end
    for _, name in ipairs(readMasterList()) do
        if not seen[name] then seen[name] = true; table.insert(list, name) end
    end
    table.sort(list)
    print("[ModernUI] Config list:", #list > 0 and table.concat(list, ", ") or "(empty)")
    return list
end

function Library:SaveConfig(name)
    name = sanitizeName(name)
    if not writefile then
        Library:Notify({Title = "Save Failed", Text = "Executor tidak support writefile", Type = "error", Duration = 6})
        return false
    end
    local data, count = {}, 0
    for k, v in pairs(Library.Flags) do
        count = count + 1
        if typeof(v) == "Color3" then
            data[k] = {__t = "Color3", r = v.R, g = v.G, b = v.B}
        elseif typeof(v) == "EnumItem" then
            data[k] = {__t = "EnumItem", enum = tostring(v.EnumType), name = v.Name}
        elseif type(v) == "table" then
            data[k] = {__t = "Table", items = v}
        else
            data[k] = v
        end
    end
    local okJson, json = pcall(function() return HttpService:JSONEncode(data) end)
    if not okJson then
        Library:Notify({Title = "Save Failed", Text = "Encode error: " .. tostring(json), Type = "error", Duration = 6})
        return false
    end
    local path = configPath(name)
    local wok, werr = pcall(writefile, path, json)
    if not wok then
        Library:Notify({Title = "Save Failed", Text = "Write error: " .. tostring(werr), Type = "error", Duration = 6})
        return false
    end
    if isfile and not isfile(path) then
        Library:Notify({Title = "Save Failed", Text = "File hilang setelah write", Type = "error", Duration = 6})
        return false
    end
    Library:_trackConfig(name)
    Library:Notify({Title = "Saved", Text = name .. " (" .. count .. " flags)", Type = "success"})
    return true
end

function Library:LoadConfig(name)
    name = sanitizeName(name)
    if not (readfile) then
        Library:Notify({Title = "Load Failed", Text = "Executor tidak support readfile", Type = "error", Duration = 6})
        return false
    end
    local path = configPath(name)
    if isfile and not isfile(path) then
        Library:Notify({Title = "Not Found", Text = name, Type = "warning"})
        return false
    end
    local ok, data = pcall(readfile, path)
    if not ok or not data then
        Library:Notify({Title = "Load Failed", Text = "Read error", Type = "error", Duration = 6})
        return false
    end
    local decOk, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not decOk or type(decoded) ~= "table" then
        Library:Notify({Title = "Load Failed", Text = "Invalid JSON", Type = "error", Duration = 6})
        return false
    end
    local applied = 0
    for k, v in pairs(decoded) do
        local val = v
        if type(v) == "table" and v.__t then
            if v.__t == "Color3" then val = Color3.new(v.r, v.g, v.b)
            elseif v.__t == "EnumItem" then
                local et = Enum[v.enum]
                if et then val = et[v.name] end
            elseif v.__t == "Table" then val = v.items end
        end
        Library.Flags[k] = val
        if Library._setters[k] then pcall(Library._setters[k], val); applied = applied + 1 end
    end
    Library:Notify({Title = "Loaded", Text = name .. " (" .. applied .. " applied)", Type = "success"})
    return true
end

function Library:DeleteConfig(name)
    name = sanitizeName(name)
    local path = configPath(name)
    if isfile and isfile(path) and delfile then pcall(delfile, path) end
    Library:_untrackConfig(name)
    Library:Notify({Title = "Deleted", Text = name, Type = "info"})
    return true
end

function Library:SetAutoLoadConfig(name)
    if not writefile then return false end
    if name then
        pcall(writefile, autoPath(), sanitizeName(name))
        Library:Notify({Title = "Auto-Load", Text = sanitizeName(name), Type = "success"})
    else
        if delfile then pcall(delfile, autoPath()) end
        Library:Notify({Title = "Auto-Load", Text = "Disabled", Type = "info"})
    end
    return true
end

function Library:GetAutoLoadConfig()
    if not readfile then return nil end
    if isfile and not isfile(autoPath()) then return nil end
    local ok, data = pcall(readfile, autoPath())
    if ok and data and data ~= "" then return data end
    return nil
end

