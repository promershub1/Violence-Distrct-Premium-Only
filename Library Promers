-- 🎨 REAL COLOR PICKER (SV Square via 40 strips + Hue Bar)
-- ═══════════════════════════════════════════════════════
function Library:ColorPicker(parent, opts)
    opts = opts or {}
    local color = opts.Default or Color3.fromRGB(255, 255, 255)
    local cb = opts.Callback or function() end
    local h360, s, v = Color3.toHSV(color)
    h360 = h360 * 360
    local open = false
    local renderConn, outsideConn

    local container = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(container, 6)
    local header = create("TextButton", {Parent = container, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = ""})
    create("TextLabel", {Parent = header, Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Color", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local hp = create("Frame", {Parent = header, Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -30, 0.5, -10), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 2})
    corner(hp, 4); stroke(hp, Library.Theme.Stroke, 1)

    local POPUP_W = 170
    local POPUP_H = 250
    local SV_SIZE = 140
    local ROWS = 40

    local popup, closeBtn = buildPopup(parent, opts.Text)
    popup.Size = UDim2.new(0, POPUP_W, 0, 0)

    -- SV SQUARE (base frame that holds 40 horizontal strips)
    local svFrame = create("Frame", {Parent = popup, Size = UDim2.new(0, SV_SIZE, 0, SV_SIZE), Position = UDim2.new(0.5, -SV_SIZE/2, 0, 40), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 501})
    corner(svFrame, 4); stroke(svFrame, Color3.fromRGB(80, 80, 80), 1)

    local strips = {}
    local rowHeight = SV_SIZE / ROWS
    for i = 0, ROWS - 1 do
        local val = 1 - (i / (ROWS - 1))
        local strip = create("Frame", {
            Parent = svFrame,
            Size = UDim2.new(1, 0, 0, math.ceil(rowHeight) + 1),
            Position = UDim2.new(0, 0, 0, math.floor(i * rowHeight)),
            BackgroundColor3 = Color3.fromHSV(h360 / 360, 0, val),
            BorderSizePixel = 0, ZIndex = 502,
        })
        local grad = create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(h360 / 360, 0, val)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(h360 / 360, 1, val)),
            }),
            Parent = strip,
        })
        strips[i + 1] = {strip = strip, grad = grad, val = val}
    end

    -- Cursor
    local cursor = create("Frame", {Parent = svFrame, Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(s, 0, 1 - v, 0), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 510})
    cornerCircle(cursor); stroke(cursor, Color3.new(1,1,1), 2)
    local cursorInner = create("Frame", {Parent = cursor, Size = UDim2.new(1, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 511})
    cornerCircle(cursorInner); stroke(cursorInner, Color3.new(0,0,0), 1)

    -- SV input
    local svInput = create("TextButton", {Parent = svFrame, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 512})

    -- Hue bar (30 segments)
    local hueBar = create("Frame", {Parent = popup, Size = UDim2.new(0, SV_SIZE, 0, 14), Position = UDim2.new(0.5, -SV_SIZE/2, 0, 40 + SV_SIZE + 10), BackgroundColor3 = Color3.fromRGB(255,0,0), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 501})
    corner(hueBar, 7); stroke(hueBar, Color3.fromRGB(80, 80, 80), 1)
    local HUESEG = 30
    for i = 0, HUESEG - 1 do
        create("Frame", {
            Parent = hueBar,
            Size = UDim2.new(1 / HUESEG, 1, 1, 0),
            Position = UDim2.new(i / HUESEG, 0, 0, 0),
            BackgroundColor3 = Color3.fromHSV(i / (HUESEG - 1), 1, 1),
            BorderSizePixel = 0, ZIndex = 502,
        })
    end
    local hueCursor = create("Frame", {Parent = hueBar, Size = UDim2.new(0, 6, 1.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h360 / 360, 0, 0.5, 0), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 503})
    corner(hueCursor, 3); stroke(hueCursor, Color3.new(0,0,0), 1)
    local hueInput = create("TextButton", {Parent = hueBar, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 504})

    -- Preview + hex
    local previewRow = create("Frame", {Parent = popup, Size = UDim2.new(0, SV_SIZE, 0, 26), Position = UDim2.new(0.5, -SV_SIZE/2, 0, 40 + SV_SIZE + 10 + 14 + 10), BackgroundTransparency = 1, ZIndex = 501})
    local preview = create("Frame", {Parent = previewRow, Size = UDim2.new(0, 26, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 502})
    corner(preview, 4); stroke(preview, Library.Theme.Stroke, 1)
    local hexBox = create("TextBox", {Parent = previewRow, Size = UDim2.new(1, -34, 1, 0), Position = UDim2.new(0, 34, 0, 0), BackgroundColor3 = Library.Theme.Bg, TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 12, Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255), BorderSizePixel = 0, ZIndex = 502, ClearTextOnFocus = false})
    corner(hexBox, 4); stroke(hexBox, Library.Theme.Stroke, 1)

    local function refreshSV()
        for _, row in ipairs(strips) do
            local cl = Color3.fromHSV(h360 / 360, 0, row.val)
            local cr = Color3.fromHSV(h360 / 360, 1, row.val)
            row.strip.BackgroundColor3 = cl
            row.grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cl), ColorSequenceKeypoint.new(1, cr)})
        end
    end

    local function updateColor(fire)
        color = Color3.fromHSV(h360 / 360, s, v)
        cursor.Position = UDim2.new(s, 0, 1 - v, 0)
        cursor.BackgroundColor3 = color
        hueCursor.Position = UDim2.new(h360 / 360, 0, 0.5, 0)
        preview.BackgroundColor3 = color
        hp.BackgroundColor3 = color
        Library.Flags[opts.Flag] = color
        if not hexBox:IsFocused() then hexBox.Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255) end
        if fire then cb(color) end
    end

    local dragSV, dragHue = false, false
    svInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragSV = true
            s = math.clamp((input.Position.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((input.Position.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
            updateColor(true)
        end
    end)
    hueInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragHue = true
            h360 = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1) * 360
            refreshSV(); updateColor(true)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragSV then
                s = math.clamp((input.Position.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
                v = 1 - math.clamp((input.Position.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
                updateColor(true)
            elseif dragHue then
                h360 = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1) * 360
                refreshSV(); updateColor(true)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragSV = false; dragHue = false
        end
    end)
    hexBox.FocusLost:Connect(function()
        local hx = hexBox.Text:gsub("#", "")
        if #hx == 6 then
            local r = tonumber(hx:sub(1,2), 16)
            local g = tonumber(hx:sub(3,4), 16)
            local b = tonumber(hx:sub(5,6), 16)
            if r and g and b then
                local nc = Color3.fromRGB(r, g, b)
                local nh, ns, nv = Color3.toHSV(nc)
                h360 = nh * 360; s = ns; v = nv
                refreshSV(); updateColor(true); return
            end
        end
        hexBox.Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255)
    end)

    local openPopup, closePopup
    openPopup = function()
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        open = true; popup.Visible = true
        local ap = container.AbsolutePosition
        local vy = workspace.CurrentCamera.ViewportSize.Y
        local y = ap.Y + container.AbsoluteSize.Y + 4
        if y + POPUP_H > vy - 10 then y = ap.Y - POPUP_H - 4 end
        popup.Position = UDim2.new(0, ap.X + container.AbsoluteSize.X/2 - POPUP_W/2, 0, y)
        popup.Size = UDim2.new(0, POPUP_W, 0, 0)
        tween(popup, {Size = UDim2.new(0, POPUP_W, 0, POPUP_H)}, 0.18)
        task.delay(0.06, function()
            if not open then return end
            outsideConn = UserInputService.InputBegan:Connect(function(input, gp)
                if gp or not open then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mx, my = input.Position.X, input.Position.Y
                    local px, py = popup.AbsolutePosition.X, popup.AbsolutePosition.Y
                    local pw, ph = popup.AbsoluteSize.X, popup.AbsoluteSize.Y
                    local ins = mx >= px and mx <= px + pw and my >= py and my <= py + ph
                    if not ins then closePopup() end
                end
            end)
        end)
    end
    closePopup = function()
        if not open then return end
        open = false; tween(popup, {Size = UDim2.new(0, POPUP_W, 0, 0)}, 0.13)
        task.delay(0.15, function() if not open then popup.Visible = false end end)
        if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
    end
    closeBtn.MouseButton1Click:Connect(function() closePopup() end)
    header.MouseButton1Click:Connect(function() if open then closePopup() else openPopup() end end)
    table.insert(Library._activeDropdowns, closePopup)

    local api = {
        Set = function(_, nc, fire)
            color = nc
            local nh, ns, nv = Color3.toHSV(color)
            h360 = nh * 360; s = ns; v = nv
            refreshSV(); updateColor(false)
            if fire ~= false then cb(color) end
        end,
        Get = function() return color end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = color; registerFlag(opts.Flag, function(c) api.Set(api, c, false) end) end
    return api
end

-- KEYBIND
function Library:Keybind(parent, opts)
    opts = opts or {}
    local value = opts.Default or Enum.KeyCode.Unknown
    local cb = opts.Callback or function() end
    local listening = false
    local frame = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(frame, 6)
    create("TextLabel", {Parent = frame, Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Keybind", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local kb = create("TextButton", {Parent = frame, Size = UDim2.new(0, 90, 1, -8), Position = UDim2.new(1, -98, 0, 4), BackgroundColor3 = Library.Theme.Bg, Text = (value == Enum.KeyCode.Unknown) and "None" or value.Name, TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = false})
    corner(kb, 4); stroke(kb, Library.Theme.Stroke, 1)
    kb.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true; kb.Text = "..."; kb.TextColor3 = Library.Theme.Sub
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                value = input.KeyCode; kb.Text = value.Name; kb.TextColor3 = Library.Theme.Text
                listening = false; conn:Disconnect(); Library.Flags[opts.Flag] = value; cb(value)
            end
        end)
    end)
    local api = {
        Set = function(_, v, fire) value = v; kb.Text = v.Name; Library.Flags[opts.Flag] = v; if fire ~= false then cb(v) end end,
        Get = function() return value end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = value; registerFlag(opts.Flag, function(v) api.Set(api, v, false) end) end
    return api
end

-- BUTTON
function Library:Button(parent, opts)
    opts = opts or {}
    local cb = opts.Callback or function() end
    local btn = create("TextButton", {Parent = parent, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Library.Theme.Bg3, Text = opts.Text or "Button", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false, BorderSizePixel = 0})
    corner(btn, 6); stroke(btn, Library.Theme.Stroke, 1)
    btn.MouseEnter:Connect(function() tween(btn, {BackgroundColor3 = Library.Theme.Hover}, 0.15) end)
    btn.MouseLeave:Connect(function() tween(btn, {BackgroundColor3 = Library.Theme.Bg3}, 0.15) end)
    btn.MouseButton1Click:Connect(cb)
    return btn
end

return Library
