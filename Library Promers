-- TOGGLE
function Library:Toggle(parent, opts)
    opts = opts or {}
    local state = opts.Default or false
    local callback = opts.Callback or function() end
    local frame = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(frame, 6)
    create("TextLabel", {Parent = frame, Size = UDim2.new(1, -70, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Toggle", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local track = create("Frame", {Parent = frame, Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundTransparency = 1, BorderSizePixel = 0})
    corner(track, 10)
    local bgDark = create("Frame", {Parent = track, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(60, 60, 60), BorderSizePixel = 0, ZIndex = 1})
    corner(bgDark, 10)
    local bgLight = create("Frame", {Parent = track, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = state and 0 or 1, BorderSizePixel = 0, ZIndex = 2})
    corner(bgLight, 10)
    local to = create("Frame", {Parent = track, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10})
    corner(to, 10); stroke(to, Library.Theme.Stroke, 1)
    local thumb = create("Frame", {Parent = track, Size = UDim2.new(0, 16, 0, 16), Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 5})
    cornerCircle(thumb); stroke(thumb, Color3.fromRGB(70, 70, 70), 1)
    local btn = create("TextButton", {Parent = frame, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 15})
    local api = {}
    function api:Set(v, fire)
        state = v
        tween(bgLight, {BackgroundTransparency = state and 0 or 1}, 0.2)
        tween(thumb, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}, 0.2)
        Library.Flags[opts.Flag] = state
        if fire ~= false then callback(state) end
    end
    function api:Get() return state end
    btn.MouseButton1Click:Connect(function() api:Set(not state) end)
    if opts.Flag then Library.Flags[opts.Flag] = state; registerFlag(opts.Flag, function(v) api:Set(v) end) end
    return api
end

