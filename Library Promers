-- CONFIG MANAGER
local function configPath(name) return Library.ConfigPrefix .. name .. ".json" end
local function masterPath() return Library.ConfigPrefix .. "master.json" end
local function autoPath() return Library.ConfigPrefix .. "autoload.txt" end
local function readMasterList()
    if isfile and isfile(masterPath()) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(masterPath())) end)
        if ok and type(data) == "table" and type(data.configs) == "table" then return data.configs end
    end
    return {}
end
local function writeMasterList(list)
    if writefile then pcall(writefile, masterPath(), HttpService:JSONEncode({configs = list})) end
end
function Library:_trackConfig(name)
    local list = readMasterList()
    for _, n in ipairs(list) do if n == name then return end end
    table.insert(list, name); writeMasterList(list)
end
function Library:_untrackConfig(name)
    local list = readMasterList()
    for i, n in ipairs(list) do if n == name then table.remove(list, i); break end end
    writeMasterList(list)
end
function Library:GetConfigList()
    local list, seen = {}, {}
    if type(listfiles) == "function" then
        local ok, files = pcall(listfiles)
        if ok and type(files) == "table" then
            for _, file in ipairs(files) do
                local name = file:match(Library.ConfigPrefix .. "(.+)%.json$")
                if name and name ~= "master" and not seen[name] then seen[name] = true; table.insert(list, name) end
            end
        end
    end
    for _, name in ipairs(readMasterList()) do
        if not seen[name] then seen[name] = true; table.insert(list, name) end
    end
    table.sort(list)
    return list
end
function Library:SaveConfig(name)
    if not writefile then Library:Notify({Title = "Error", Text = "writefile not supported", Type = "error"}); return false end
    name = name or "default"
    local data = {}
    for k, v in pairs(Library.Flags) do
        if typeof(v) == "Color3" then data[k] = {__t = "Color3", r = v.R, g = v.G, b = v.B}
        elseif typeof(v) == "EnumItem" then data[k] = {__t = "EnumItem", enum = v.EnumType.Name, name = v.Name}
        elseif type(v) == "table" then data[k] = {__t = "Table", items = v}
        else data[k] = v end
    end
    if pcall(writefile, configPath(name), HttpService:JSONEncode(data)) then
        Library:_trackConfig(name); Library:Notify({Title = "Saved", Text = "Config: " .. name, Type = "success"}); return true
    else Library:Notify({Title = "Error", Text = "Failed to save", Type = "error"}); return false end
end
function Library:LoadConfig(name)
    if not (isfile and readfile) then Library:Notify({Title = "Error", Text = "readfile not supported", Type = "error"}); return false end
    name = name or "default"
    if not isfile(configPath(name)) then Library:Notify({Title = "Not Found", Text = "Config: " .. name, Type = "warning"}); return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(configPath(name))) end)
    if not ok or type(data) ~= "table" then Library:Notify({Title = "Error", Text = "Invalid config", Type = "error"}); return false end
    for k, v in pairs(data) do
        local val = v
        if type(v) == "table" and v.__t then
            if v.__t == "Color3" then val = Color3.new(v.r, v.g, v.b)
            elseif v.__t == "EnumItem" then local et = Enum[v.enum]; if et then val = et[v.name] end
            elseif v.__t == "Table" then val = v.items end
        end
        Library.Flags[k] = val
        if Library._setters[k] then pcall(Library._setters[k], val) end
    end
    Library:Notify({Title = "Loaded", Text = "Config: " .. name, Type = "success"})
    return true
end
function Library:DeleteConfig(name)
    if not name then return false end
    if isfile and isfile(configPath(name)) and delfile then pcall(delfile, configPath(name)) end
    Library:_untrackConfig(name); Library:Notify({Title = "Deleted", Text = "Config: " .. name, Type = "info"}); return true
end
function Library:SetAutoLoadConfig(name)
    if not writefile then return false end
    if name then pcall(writefile, autoPath(), name); Library:Notify({Title = "Auto-Load", Text = "Set: " .. name, Type = "success"})
    else if delfile then pcall(delfile, autoPath()) end; Library:Notify({Title = "Auto-Load", Text = "Disabled", Type = "info"}) end
    return true
end
function Library:GetAutoLoadConfig()
    if isfile and isfile(autoPath()) then
        local ok, data = pcall(readfile, autoPath())
        if ok and data and data ~= "" then return data end
    end
    return nil
end

