-- 🎨 REAL COLOR PICKER (SV Grid 20×20, 100% RELIABLE)
-- ═══════════════════════════════════════════════════════
function Library:ColorPicker(parent, opts)
    opts = opts or {}
    local color = opts.Default or Color3.fromRGB(255, 255, 255)
    local callback = opts.Callback or function() end
    local hNorm, s, v = Color3.toHSV(color)
    local h = hNorm * 360  -- convert to [0, 360] to keep consistent
    local open = false
    local renderConn, outsideConn

    -- Header row
    local container = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(container, 6)
    local header = create("TextButton", {Parent = container, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
    create("TextLabel", {Parent = header, Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Color", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local headerPreview = create("Frame", {Parent = header, Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -30, 0.5, -10), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 2})
    corner(headerPreview, 4); stroke(headerPreview, Library.Theme.Stroke, 1)
    header.MouseEnter:Connect(function() tween(container, {BackgroundColor3 = Library.Theme.Hover}, 0.12) end)
    header.MouseLeave:Connect(function() tween(container, {BackgroundColor3 = Library.Theme.Bg3}, 0.12) end)

    local TH = 255
    local popup, closeBtn = buildPopup(parent, opts.Text)

    -- ═══ SV GRID (20×20 solid color cells) ═══
    local GRID = 20
    local SV_SIZE = 120
    local svFrame = create("Frame", {Parent = popup, Size = UDim2.new(0, SV_SIZE, 0, SV_SIZE), Position = UDim2.new(0.5, -SV_SIZE/2, 0, 39), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 501})
    corner(svFrame, 4)

    local cellSize = SV_SIZE / GRID
    local cells = {}
    for gy = 0, GRID - 1 do
        for gx = 0, GRID - 1 do
            local cell = create("Frame", {
                Parent = svFrame,
                Size = UDim2.new(0, math.ceil(cellSize) + 1, 0, math.ceil(cellSize) + 1),
                Position = UDim2.new(0, math.floor(gx * cellSize), 0, math.floor(gy * cellSize)),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderSizePixel = 0, ZIndex = 502,
            })
            cells[gy * GRID + gx + 1] = {frame = cell, gx = gx, gy = gy}
        end
    end

    local function refreshGrid()
        for _, data in ipairs(cells) do
            local sat = data.gx / (GRID - 1)
            local val = 1 - (data.gy / (GRID - 1))
            data.frame.BackgroundColor3 = Color3.fromHSV(h, sat, val)
        end
    end
    refreshGrid()

    -- SV cursor
    local svCursor = create("Frame", {Parent = svFrame, Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(s, 0, 1 - v, 0), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 510})
    cornerCircle(svCursor); stroke(svCursor, Color3.new(1, 1, 1), 2)
    create("Frame", {Parent = svCursor, Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 511}).Size = UDim2.new(1, -6, 1, -6)
    local svInner = create("Frame", {Parent = svCursor, Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 511})
    cornerCircle(svInner); stroke(svInner, Color3.new(0, 0, 0), 1)

    -- SV input
    local svInput = create("TextButton", {Parent = svFrame, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 512})

    -- ═══ HUE BAR (30 solid segments) ═══
    local HUE_SEG = 30
    local hueBar = create("Frame", {Parent = popup, Size = UDim2.new(0, SV_SIZE, 0, 14), Position = UDim2.new(0.5, -SV_SIZE/2, 0, 39 + SV_SIZE + 10), BackgroundColor3 = Color3.fromRGB(255, 0, 0), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 501})
    corner(hueBar, 7)
    local segWidth = SV_SIZE / HUE_SEG
    for i = 0, HUE_SEG - 1 do
        create("Frame", {
            Parent = hueBar,
            Size = UDim2.new(0, segWidth + 1, 1, 0),
            Position = UDim2.new(0, i * segWidth, 0, 0),
            BackgroundColor3 = Color3.fromHSV((i / (HUE_SEG - 1)) * 360, 1, 1),
            BorderSizePixel = 0, ZIndex = 502,
        })
    end
    local hueCursor = create("Frame", {Parent = hueBar, Size = UDim2.new(0, 6, 1.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h / 360, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 503})
    corner(hueCursor, 3); stroke(hueCursor, Color3.new(0, 0, 0), 1)
    local hueInput = create("TextButton", {Parent = hueBar, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 504})

    -- ═══ PREVIEW + HEX ═══
    local previewRow = create("Frame", {Parent = popup, Size = UDim2.new(0, SV_SIZE, 0, 26), Position = UDim2.new(0.5, -SV_SIZE/2, 0, 39 + SV_SIZE + 10 + 14 + 10), BackgroundTransparency = 1, ZIndex = 501})
    local preview = create("Frame", {Parent = previewRow, Size = UDim2.new(0, 26, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 502})
    corner(preview, 4); stroke(preview, Library.Theme.Stroke, 1)
    local hexInput = create("TextBox", {Parent = previewRow, Size = UDim2.new(1, -34, 1, 0), Position = UDim2.new(0, 34, 0, 0), BackgroundColor3 = Library.Theme.Bg, TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 12, Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255), BorderSizePixel = 0, ZIndex = 502, ClearTextOnFocus = false})
    corner(hexInput, 4); stroke(hexInput, Library.Theme.Stroke, 1)

    local function updateAll(fire)
        color = Color3.fromHSV(h, s, v)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        svCursor.BackgroundColor3 = color
        hueCursor.Position = UDim2.new(h / 360, 0, 0.5, 0)
        preview.BackgroundColor3 = color
        headerPreview.BackgroundColor3 = color
        Library.Flags[opts.Flag] = color
        if not hexInput:IsFocused() then
            hexInput.Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255)
        end
        if fire then callback(color) end
    end

    -- Drag handlers
    local dragSV = false
    local function fromSVInput(input)
        local relX = math.clamp((input.Position.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
        local relY = math.clamp((input.Position.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
        s = relX
        v = 1 - relY
        updateAll(true)
    end
    svInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragSV = true; dragHue = false
            fromSVInput(input)
        end
    end)

    local dragHue = false
    local lastGridRefresh = 0
    local function fromHueInput(input)
        local relX = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
        h = relX * 360
        local now = tick()
        if now - lastGridRefresh > 0.04 then
            lastGridRefresh = now
            refreshGrid()
        end
        updateAll(true)
    end
    hueInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragHue = true; dragSV = false
            fromHueInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragSV then fromSVInput(input)
            elseif dragHue then fromHueInput(input) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragSV = false; dragHue = false
        end
    end)

    hexInput.FocusLost:Connect(function()
        local hex = hexInput.Text:gsub("#", "")
        if #hex == 6 then
            local r = tonumber(hex:sub(1, 2), 16)
            local g = tonumber(hex:sub(3, 4), 16)
            local b = tonumber(hex:sub(5, 6), 16)
            if r and g and b then
                local nc = Color3.fromRGB(r, g, b)
                local nh, ns, nv = Color3.toHSV(nc)
                h = nh * 360; s = ns; v = nv
                refreshGrid(); updateAll(true); return
            end
        end
        hexInput.Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255)
    end)

    local openPopup, closePopup
    openPopup = function()
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        open = true; popup.Visible = true
        local absPos = container.AbsolutePosition
        local popupW = math.max(container.AbsoluteSize.X, SV_SIZE + 20)
        local vpY = workspace.CurrentCamera.ViewportSize.Y
        local y = absPos.Y + container.AbsoluteSize.Y + 4
        if y + TH > vpY - 10 then y = absPos.Y - TH - 4 end
        popup.Position = UDim2.new(0, absPos.X, 0, y)
        popup.Size = UDim2.new(0, popupW, 0, 0)
        tween(popup, {Size = UDim2.new(0, popupW, 0, TH)}, 0.18)
        renderConn = RunService.RenderStepped:Connect(function()
            if not open then return end
            local ap = container.AbsolutePosition
            popup.Position = UDim2.new(0, ap.X, 0, popup.Position.Y.Offset)
        end)
        task.delay(0.06, function()
            if not open then return end
            outsideConn = UserInputService.InputBegan:Connect(function(input, gp)
                if gp or not open then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mx, my = input.Position.X, input.Position.Y
                    local px, py = popup.AbsolutePosition.X, popup.AbsolutePosition.Y
                    local pw, ph = popup.AbsoluteSize.X, popup.AbsoluteSize.Y
                    local inside = mx >= px and mx <= px + pw and my >= py and my <= py + ph
                    local hx, hy = header.AbsolutePosition.X, header.AbsolutePosition.Y
                    local hw, hh = header.AbsoluteSize.X, header.AbsoluteSize.Y
                    local inH = mx >= hx and mx <= hx + hw and my >= hy and my <= hy + hh
                    if not inside and not inH then closePopup() end
                end
            end)
        end)
    end
    closePopup = function()
        if not open then return end
        open = false
        tween(popup, {Size = UDim2.new(0, popup.Size.X.Offset, 0, 0)}, 0.13)
        task.delay(0.15, function() if not open then popup.Visible = false end end)
        if renderConn then renderConn:Disconnect(); renderConn = nil end
        if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
    end
    closeBtn.MouseButton1Click:Connect(function() closePopup() end)
    header.MouseButton1Click:Connect(function() if open then closePopup() else openPopup() end end)
    table.insert(Library._activeDropdowns, closePopup)

    local api = {
        Set = function(_, nc, fire)
            color = nc
            local nh, ns, nv = Color3.toHSV(color)
            h = nh * 360; s = ns; v = nv
            refreshGrid(); updateAll(false)
            if fire ~= false then callback(color) end
        end,
        Get = function() return color end,
    }
    if opts.Flag then
        Library.Flags[opts.Flag] = color
        registerFlag(opts.Flag, function(c) api.Set(api, c, false) end)
    end
    return api
end

-- KEYBIND
function Library:Keybind(parent, opts)
    opts = opts or {}
    local value = opts.Default or Enum.KeyCode.Unknown
    local callback = opts.Callback or function() end
    local listening = false
    local frame = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(frame, 6)
    create("TextLabel", {Parent = frame, Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Keybind", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local kb = create("TextButton", {Parent = frame, Size = UDim2.new(0, 90, 1, -8), Position = UDim2.new(1, -98, 0, 4), BackgroundColor3 = Library.Theme.Bg, Text = (value == Enum.KeyCode.Unknown) and "None" or value.Name, TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = false})
    corner(kb, 4); stroke(kb, Library.Theme.Stroke, 1)
    local conn
    kb.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true; kb.Text = "..."; kb.TextColor3 = Library.Theme.Sub
        conn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                value = input.KeyCode; kb.Text = value.Name; kb.TextColor3 = Library.Theme.Text
                listening = false; conn:Disconnect(); Library.Flags[opts.Flag] = value; callback(value)
            end
        end)
    end)
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if not listening and value ~= Enum.KeyCode.Unknown and input.KeyCode == value then callback(value) end
    end)
    local api = {
        Set = function(_, v, fire) value = v; kb.Text = v.Name; Library.Flags[opts.Flag] = v; if fire ~= false then callback(v) end end,
        Get = function() return value end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = value; registerFlag(opts.Flag, function(v) api.Set(api, v, false) end) end
    return api
end

-- BUTTON
function Library:Button(parent, opts)
    opts = opts or {}
    local callback = opts.Callback or function() end
    local btn = create("TextButton", {Parent = parent, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Library.Theme.Bg3, Text = opts.Text or "Button", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, AutoButtonColor = false, BorderSizePixel = 0})
    corner(btn, 6); stroke(btn)
    local sc = create("UIScale", {Scale = 1, Parent = btn})
    btn.MouseEnter:Connect(function() tween(btn, {BackgroundColor3 = Library.Theme.Hover}, 0.15) end)
    btn.MouseLeave:Connect(function() tween(btn, {BackgroundColor3 = Library.Theme.Bg3}, 0.15) end)
    btn.MouseButton1Down:Connect(function() tween(sc, {Scale = 0.96}, 0.06) end)
    btn.MouseButton1Up:Connect(function() tween(sc, {Scale = 1}, 0.12) end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

return Library
