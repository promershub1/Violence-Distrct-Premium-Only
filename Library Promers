        local indicator = create("Frame", {Parent = tabBtn, Size = UDim2.new(0, 3, 0, 14), Position = UDim2.new(0, 8, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, BackgroundTransparency = 1, ZIndex = 8})
        corner(indicator, 2)
        create("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 180, 180))}), Rotation = 90, Parent = indicator})
        local tabLabel = create("TextLabel", {Parent = tabBtn, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 24, 0, 0), BackgroundTransparency = 1, Text = name, TextColor3 = Library.Theme.Sub, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8})
        local page = create("ScrollingFrame", {Parent = pageContainer, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80), CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 6})
        create("UIListLayout", {Parent = page, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder})
        create("UIPadding", {Parent = page, PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 4)})
        tab.Page = page; tab.Button = tabBtn; tab.Indicator = indicator; tab.Label = tabLabel
        table.insert(tabs, tab)
        tabBtn.MouseButton1Click:Connect(function()
            if window._destroyed then return end
            for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
            for _, t in ipairs(tabs) do
                t.Page.Visible = false; tween(t.Button, {BackgroundColor3 = Library.Theme.Bg2}, 0.15)
                tween(t.Label, {TextColor3 = Library.Theme.Sub}, 0.15)
                tween(t.Indicator, {BackgroundTransparency = 1, Position = UDim2.new(0, 4, 0.5, -7)}, 0.15)
            end
            page.Visible = true; tween(tabBtn, {BackgroundColor3 = Library.Theme.Bg3}, 0.15)
            tween(tabLabel, {TextColor3 = Library.Theme.Text}, 0.15)
            indicator.BackgroundTransparency = 0; indicator.Position = UDim2.new(0, 4, 0.5, -7)
            tween(indicator, {BackgroundTransparency = 0, Position = UDim2.new(0, 8, 0.5, -7)}, 0.18)
        end)
        tabBtn.MouseEnter:Connect(function()
            if window._destroyed or page.Visible then return end
            tween(tabBtn, {BackgroundColor3 = Color3.fromRGB(28, 28, 28)}, 0.1); tween(tabLabel, {TextColor3 = Library.Theme.Text}, 0.1); tween(indicator, {BackgroundTransparency = 0.7}, 0.1)
        end)
        tabBtn.MouseLeave:Connect(function()
            if window._destroyed or page.Visible then return end
            tween(tabBtn, {BackgroundColor3 = Library.Theme.Bg2}, 0.1); tween(tabLabel, {TextColor3 = Library.Theme.Sub}, 0.1); tween(indicator, {BackgroundTransparency = 1}, 0.1)
        end)
        if #tabs == 1 then
            page.Visible = true; tabBtn.BackgroundColor3 = Library.Theme.Bg3; tabLabel.TextColor3 = Library.Theme.Text; indicator.BackgroundTransparency = 0
        end
        return tab
    end
    local function showWindow()
        if window._destroyed then return end
        main.Visible = true; float.Visible = false; uiScale.Scale = 0.92; tween(uiScale, {Scale = 1}, 0.28)
    end
    local function hideWindow()
        if window._destroyed then return end
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        local tw = tween(uiScale, {Scale = 0.92}, 0.15)
        tw.Completed:Connect(function()
            if window._destroyed then return end
            main.Visible = false; float.Visible = true; uiScale.Scale = 1
        end)
    end
    window.Show = showWindow; window.Hide = hideWindow
    function window:Destroy()
        if window._destroyed then return end
        window._destroyed = true
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        Library._activeDropdowns = {}
        task.delay(0.2, function() pcall(function() gui:Destroy() end) end)
    end
    local dialogOpen = false
    local function showCloseConfirm()
        if dialogOpen or window._destroyed then return end
        dialogOpen = true
        local overlay = create("TextButton", {Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 900})
        local dialog = create("Frame", {Parent = gui, Size = UDim2.new(0, 320, 0, 180), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 901})
        corner(dialog, 14)
        create("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(32, 32, 32)), ColorSequenceKeypoint.new(1, Color3.fromRGB(16, 16, 16))}), Rotation = 90, Parent = dialog})
        local ds = create("UIStroke", {Thickness = 1, Color = Color3.fromRGB(255, 255, 255), Parent = dialog})
        create("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 90, 90)), ColorSequenceKeypoint.new(1, Color3.fromRGB(35, 35, 35))}), Rotation = 90, Parent = ds})
        local iconBg = create("Frame", {Parent = dialog, Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(0, 20, 0, 18), BackgroundColor3 = Library.Theme.DangerBg, BorderSizePixel = 0, ZIndex = 902})
        corner(iconBg, 10); stroke(iconBg, Library.Theme.Danger, 1)
        create("TextLabel", {Parent = iconBg, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "!", TextColor3 = Library.Theme.Danger, Font = Enum.Font.GothamBold, TextSize = 20, ZIndex = 903})
        create("TextLabel", {Parent = dialog, Size = UDim2.new(1, -80, 0, 24), Position = UDim2.new(0, 66, 0, 22), BackgroundTransparency = 1, Text = "Close Script?", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 902})
        create("TextLabel", {Parent = dialog, Size = UDim2.new(1, -40, 0, 40), Position = UDim2.new(0, 20, 0, 62), BackgroundTransparency = 1, Text = "Are you sure you want to close the script?\nThis action cannot be undone.", TextColor3 = Library.Theme.Sub, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, ZIndex = 902})
        local btnContainer = create("Frame", {Parent = dialog, Size = UDim2.new(1, -40, 0, 32), Position = UDim2.new(0, 20, 1, -46), BackgroundTransparency = 1, ZIndex = 902})
        create("UIListLayout", {Parent = btnContainer, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder})
        local noBtn = create("TextButton", {Parent = btnContainer, Size = UDim2.new(0, 90, 1, 0), BackgroundColor3 = Library.Theme.Bg3, Text = "No", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, ZIndex = 903})
        corner(noBtn, 6); stroke(noBtn, Library.Theme.Stroke, 1)
        noBtn.MouseEnter:Connect(function() tween(noBtn, {BackgroundColor3 = Library.Theme.Hover}, 0.12) end)
        noBtn.MouseLeave:Connect(function() tween(noBtn, {BackgroundColor3 = Library.Theme.Bg3}, 0.12) end)
        local yesBtn = create("TextButton", {Parent = btnContainer, Size = UDim2.new(0, 90, 1, 0), BackgroundColor3 = Library.Theme.DangerBg, Text = "Yes", TextColor3 = Library.Theme.Danger, Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, ZIndex = 903})
        corner(yesBtn, 6); stroke(yesBtn, Library.Theme.Danger, 1)
        yesBtn.MouseEnter:Connect(function() tween(yesBtn, {BackgroundColor3 = Color3.fromRGB(110, 40, 40)}, 0.12) end)
        yesBtn.MouseLeave:Connect(function() tween(yesBtn, {BackgroundColor3 = Library.Theme.DangerBg}, 0.12) end)
        dialog.Size = UDim2.new(0, 280, 0, 150)
        tween(overlay, {BackgroundTransparency = 0.55}, 0.2); tween(dialog, {Size = UDim2.new(0, 320, 0, 180)}, 0.25)
        local function closeDialog()
            dialogOpen = false
            tween(overlay, {BackgroundTransparency = 1}, 0.15); tween(dialog, {Size = UDim2.new(0, 280, 0, 150)}, 0.15)
            task.delay(0.15, function() pcall(function() overlay:Destroy() end); pcall(function() dialog:Destroy() end) end)
        end
        noBtn.MouseButton1Click:Connect(closeDialog)
        overlay.MouseButton1Click:Connect(closeDialog)
        yesBtn.MouseButton1Click:Connect(function() closeDialog(); task.wait(0.1); window:Destroy() end)
    end
    hideBtn.MouseButton1Click:Connect(hideWindow)
    closeBtn.MouseButton1Click:Connect(showCloseConfirm)
    do
        local fDrag, fMoved, fStart, fStartPos = false, false, nil, nil
        float.InputBegan:Connect(function(input)
            if window._destroyed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                fDrag = true; fMoved = false; Library._floatDragging = true
                fStart = input.Position; fStartPos = float.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if window._destroyed or not gui.Parent then return end
            if fDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - fStart
                if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then fMoved = true end
                if fMoved then float.Position = UDim2.new(fStartPos.X.Scale, fStartPos.X.Offset + delta.X, fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y) end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if window._destroyed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if fDrag then
                    fDrag = false; Library._floatDragging = false
                    if not fMoved then showWindow() end
                end
            end
        end)
    end
    local dragging, dragStart, startPos
    dragHandle.InputBegan:Connect(function(input)
        if window._destroyed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if window._destroyed or not gui.Parent then return end
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            if (window.BorderSmoothness or 0) <= 0 then mainBorder.Position = main.Position end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    if autoLoad then
        task.delay(0.4, function()
            local autoName = Library:GetAutoLoadConfig()
            if autoName and autoName ~= "" then Library:LoadConfig(autoName) end
        end)
    end
    return window
end

