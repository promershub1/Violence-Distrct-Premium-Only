-- SLIDER
function Library:Slider(parent, opts)
    opts = opts or {}
    local min, max, value = opts.Min or 0, opts.Max or 100, opts.Default or opts.Min or 0
    local callback = opts.Callback or function() end
    local frame = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(frame, 6)
    create("TextLabel", {Parent = frame, Size = UDim2.new(1, -80, 0, 22), Position = UDim2.new(0, 10, 0, 2), BackgroundTransparency = 1, Text = opts.Text or "Slider", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local vl = create("TextLabel", {Parent = frame, Size = UDim2.new(0, 70, 0, 22), Position = UDim2.new(1, -80, 0, 2), BackgroundTransparency = 1, Text = tostring(value), TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right})
    local bar = create("Frame", {Parent = frame, Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 32), BackgroundColor3 = Library.Theme.Bg, BorderSizePixel = 0})
    corner(bar, 3); stroke(bar, Library.Theme.Stroke, 1)
    local rel0 = (value - min) / (max - min)
    local fill = create("Frame", {Parent = bar, Size = UDim2.new(rel0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 2})
    corner(fill, 3)
    local KNOB = 16
    local knob = create("Frame", {Parent = bar, Size = UDim2.new(0, KNOB, 0, KNOB), Position = UDim2.new(rel0, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 4})
    cornerCircle(knob); stroke(knob, Color3.fromRGB(70, 70, 70), 1)
    local dragging = false
    local function updateVisual(rel)
        fill.Size = UDim2.new(rel, 0, 1, 0); knob.Position = UDim2.new(rel, 0, 0.5, 0)
    end
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel + 0.5)
        updateVisual(rel); vl.Text = tostring(value); Library.Flags[opts.Flag] = value; callback(value)
    end
    local btn = create("TextButton", {Parent = bar, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.5, -12), BackgroundTransparency = 1, Text = "", ZIndex = 10})
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; tween(knob, {Size = UDim2.new(0, KNOB + 4, 0, KNOB + 4)}, 0.1); setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then dragging = false; tween(knob, {Size = UDim2.new(0, KNOB, 0, KNOB)}, 0.15) end
        end
    end)
    local api = {
        Set = function(_, v, fire)
            value = math.clamp(v, min, max); local rel = (value - min) / (max - min)
            updateVisual(rel); vl.Text = tostring(value); Library.Flags[opts.Flag] = value
            if fire ~= false then callback(value) end
        end, Get = function() return value end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = value; registerFlag(opts.Flag, function(v) api.Set(api, v) end) end
    return api
end

