            for opt, d in pairs(optData) do
                local s = selected[opt] == true
                d.btn.BackgroundTransparency = s and 0 or 1; d.label.TextColor3 = s and Library.Theme.Text or Library.Theme.Sub
                d.label.Font = s and Enum.Font.GothamBold or Enum.Font.Gotham
                d.mb.BackgroundColor3 = s and Color3.fromRGB(255, 255, 255) or Library.Theme.Bg
                d.mbs.Color = s and Color3.fromRGB(255, 255, 255) or Library.Theme.Stroke
                d.mc.TextTransparency = s and 0 or 1
            end
            if fire ~= false then callback(getList()) end
        end,
        Get = function() return getList() end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = getList(); registerFlag(opts.Flag, function(v) api.Set(api, v, false) end) end
    return api
end

