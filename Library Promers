    end
    local function showWindow()
        if window._destroyed then return end
        main.Visible = true; float.Visible = false; uiScale.Scale = 0.92; tween(uiScale, {Scale = 1}, 0.28)
    end
    local function hideWindow()
        if window._destroyed then return end
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        local tw = tween(uiScale, {Scale = 0.92}, 0.15)
        tw.Completed:Connect(function()
            if window._destroyed then return end
            main.Visible = false; float.Visible = true; uiScale.Scale = 1
        end)
    end
    window.Show = showWindow; window.Hide = hideWindow
    function window:Destroy()
        if window._destroyed then return end
        window._destroyed = true
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        Library._activeDropdowns = {}
        task.delay(0.2, function() pcall(function() gui:Destroy() end) end)
    end
    hideBtn.MouseButton1Click:Connect(hideWindow)
    closeBtn.MouseButton1Click:Connect(function()
        local confirm = Instance.new("TextButton")
        confirm.Parent = gui
        confirm.Size = UDim2.fromScale(1, 1)
        confirm.BackgroundColor3 = Color3.new(0, 0, 0)
        confirm.BackgroundTransparency = 0.5
        confirm.Text = ""
        confirm.ZIndex = 900
        confirm.AutoButtonColor = false
        local d = create("Frame", {Parent = gui, Size = UDim2.new(0, 300, 0, 160), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Library.Theme.Bg2, BorderSizePixel = 0, ZIndex = 901})
        corner(d, 12); stroke(d, Library.Theme.Stroke, 1)
        create("TextLabel", {Parent = d, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 20), BackgroundTransparency = 1, Text = "Close Script?", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 16, ZIndex = 902})
        create("TextLabel", {Parent = d, Size = UDim2.new(1, -40, 0, 40), Position = UDim2.new(0, 20, 0, 55), BackgroundTransparency = 1, Text = "This action cannot be undone.", TextColor3 = Library.Theme.Sub, Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, ZIndex = 902})
        local yes = create("TextButton", {Parent = d, Size = UDim2.new(0, 100, 0, 30), Position = UDim2.new(0, 50, 1, -50), BackgroundColor3 = Library.Theme.DangerBg, Text = "Yes", TextColor3 = Library.Theme.Danger, Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, ZIndex = 903})
        corner(yes, 6); stroke(yes, Library.Theme.Danger, 1)
        local no = create("TextButton", {Parent = d, Size = UDim2.new(0, 100, 0, 30), Position = UDim2.new(1, -150, 1, -50), BackgroundColor3 = Library.Theme.Bg3, Text = "No", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, ZIndex = 903})
        corner(no, 6); stroke(no, Library.Theme.Stroke, 1)
        no.MouseButton1Click:Connect(function() confirm:Destroy(); d:Destroy() end)
        confirm.MouseButton1Click:Connect(function() confirm:Destroy(); d:Destroy() end)
        yes.MouseButton1Click:Connect(function() window:Destroy() end)
    end)
    do
        local fDrag, fMoved, fStart, fStartPos = false, false, nil, nil
        float.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                fDrag = true; fMoved = false; Library._floatDragging = true
                fStart = input.Position; fStartPos = float.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if fDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - fStart
                if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then fMoved = true end
                if fMoved then float.Position = UDim2.new(fStartPos.X.Scale, fStartPos.X.Offset + delta.X, fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y) end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if fDrag then
                    fDrag = false; Library._floatDragging = false
                    if not fMoved then showWindow() end
                end
            end
        end)
    end
    local dragging, dragStart, startPos
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    if autoLoad then
        task.delay(0.5, function()
            local autoName = Library:GetAutoLoadConfig()
            if autoName and autoName ~= "" then Library:LoadConfig(autoName) end
        end)
    end
    return window
end

