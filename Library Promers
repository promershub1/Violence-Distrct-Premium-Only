local function makeOptionBtn(optionsArea, opt, isSelected, currentValue, onSelect)
    local btn = create("TextButton", {Parent = optionsArea, Size = UDim2.new(1, -12, 0, DCFG.OPT_H), BackgroundColor3 = Library.Theme.Bg3, BackgroundTransparency = isSelected and 0 or 1, Text = "", AutoButtonColor = false, ZIndex = 502})
    corner(btn, 5)
    local check = create("TextLabel", {Parent = btn, Size = UDim2.new(0, 16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Text = "✓", TextColor3 = Library.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Visible = isSelected, ZIndex = 503})
    local lbl = create("TextLabel", {Parent = btn, Size = UDim2.new(1, -36, 1, 0), Position = UDim2.new(0, 28, 0, 0), BackgroundTransparency = 1, Text = tostring(opt), TextColor3 = isSelected and Library.Theme.Text or Library.Theme.Sub, Font = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 503})
    btn.MouseEnter:Connect(function()
        if currentValue() ~= opt then tween(btn, {BackgroundTransparency = 0, BackgroundColor3 = Library.Theme.Hover}, 0.1); tween(lbl, {TextColor3 = Library.Theme.Text}, 0.1) end
    end)
    btn.MouseLeave:Connect(function()
        if currentValue() ~= opt then tween(btn, {BackgroundTransparency = 1}, 0.1); tween(lbl, {TextColor3 = Library.Theme.Sub}, 0.1) end
    end)
    btn.MouseButton1Click:Connect(function() onSelect(opt) end)
