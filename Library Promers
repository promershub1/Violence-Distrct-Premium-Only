local RotatingGradients = {}

local function create(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    return obj
end
local function corner(parent, r)
    return create("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = parent})
end
local function cornerCircle(parent)
    return create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = parent})
end
local function stroke(parent, color, thickness)
    return create("UIStroke", {Color = color or Library.Theme.Stroke, Thickness = thickness or 1, Parent = parent})
end
local function tween(obj, props, time)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play(); return t
end
local function makeGradient(parent)
    local g = create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(55, 55, 55)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(255, 255, 255)),
        }), Parent = parent
    })
    table.insert(RotatingGradients, g); return g
end
local function registerFlag(flag, setter)
    if not flag then return end
    Library._setters[flag] = setter
end

RunService.RenderStepped:Connect(function(dt)
    for _, g in ipairs(RotatingGradients) do
        g.Rotation = (g.Rotation + dt * 45) % 360
    end
end)

local function getExecutorInfo()
    local name, version = "Vanilla", "-"
    local injected = false
    if type(identifyexecutor) == "function" then
        local ok, n, v = pcall(identifyexecutor)
        if ok and n then name = tostring(n); version = v and tostring(v) or "-"; injected = true end
    end
    if not injected then
        if type(syn) == "table" then name = "Synapse X" injected = true
        elseif type(KRNL_LOADED) ~= "nil" then name = "Krnl" injected = true
        elseif type(fluxus) == "table" then name = "Fluxus" injected = true
        elseif type(secure_call) == "function" then name = "Script-Ware" injected = true end
    end
    return name, version, injected
end

