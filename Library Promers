-- DROPDOWN
function Library:Dropdown(parent, opts)
    opts = opts or {}
    local options = opts.Options or {}
    local value = opts.Default or options[1]
    local callback = opts.Callback or function() end
    local open = false
    local renderConn, outsideConn
    local optData = {}
    local container = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(container, 6)
    local header = create("TextButton", {Parent = container, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
    create("TextLabel", {Parent = header, Size = UDim2.new(0.5, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Dropdown", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local selLabel = create("TextLabel", {Parent = header, Size = UDim2.new(0.5, -30, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, Text = tostring(value or "None"), TextColor3 = Library.Theme.Sub, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
    local chevron = create("ImageLabel", {Parent = header, Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -22, 0.5, -6), BackgroundTransparency = 1, Image = "rbxassetid://6031090990", ImageColor3 = Library.Theme.Sub, ZIndex = 2})
    header.MouseEnter:Connect(function() tween(container, {BackgroundColor3 = Library.Theme.Hover}, 0.12); tween(chevron, {ImageColor3 = Library.Theme.Text}, 0.12) end)
    header.MouseLeave:Connect(function() tween(container, {BackgroundColor3 = Library.Theme.Bg3}, 0.12); tween(chevron, {ImageColor3 = Library.Theme.Sub}, 0.12) end)
    local popup, closeBtn = buildPopup(parent, opts.Text)
    local optionsArea = create("Frame", {Parent = popup, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, DCFG.HEADER_H + DCFG.DIV_H), BackgroundTransparency = 1, ZIndex = 501})
    create("UIListLayout", {Parent = optionsArea, Padding = UDim.new(0, DCFG.OPT_GAP), SortOrder = Enum.SortOrder.LayoutOrder})
    create("UIPadding", {Parent = optionsArea, PaddingTop = UDim.new(0, DCFG.PAD_Y), PaddingBottom = UDim.new(0, DCFG.PAD_Y), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)})
    local contentHeight, totalHeight = 0, 0
    local function refreshHeights()
        local n = #options
        contentHeight = n * DCFG.OPT_H + math.max(0, n - 1) * DCFG.OPT_GAP + DCFG.PAD_Y * 2
        totalHeight = DCFG.HEADER_H + DCFG.DIV_H + math.min(contentHeight, DCFG.MAX_HEIGHT)
        optionsArea.Size = UDim2.new(1, 0, 0, math.min(contentHeight, DCFG.MAX_HEIGHT))
    end
    local function refreshSelection()
        for o, d in pairs(optData) do
            local isSel = (o == value)
            d.btn.BackgroundTransparency = isSel and 0 or 1; d.btn.BackgroundColor3 = Library.Theme.Bg3
            d.label.TextColor3 = isSel and Library.Theme.Text or Library.Theme.Sub
            d.label.Font = isSel and Enum.Font.GothamBold or Enum.Font.Gotham
            d.check.Visible = isSel
        end
    end
    local api
    local function onSelect(opt)
        value = opt; selLabel.Text = tostring(value); Library.Flags[opts.Flag] = value
        refreshSelection(); if closePopup then closePopup() end; callback(value)
    end
    local function populate()
        for _, child in ipairs(optionsArea:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        optData = {}
        for _, opt in ipairs(options) do
            local isSel = (opt == value)
            optData[opt] = makeOptionBtn(optionsArea, opt, isSel, function() return value end, onSelect)
        end
        refreshHeights()
    end
    populate()
    local openPopup, closePopup
    openPopup = function()
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        open = true; popup.Visible = true
        local absPos, absSize = container.AbsolutePosition, container.AbsoluteSize
        local vpY = workspace.CurrentCamera.ViewportSize.Y
        local y = absPos.Y + absSize.Y + 4
        if y + totalHeight > vpY - 10 then y = absPos.Y - totalHeight - 4 end
        popup.Position = UDim2.new(0, absPos.X, 0, y); popup.Size = UDim2.new(0, absSize.X, 0, 0)
        tween(popup, {Size = UDim2.new(0, absSize.X, 0, totalHeight)}, 0.18); tween(chevron, {Rotation = 180}, 0.2)
        renderConn = RunService.RenderStepped:Connect(function()
            if not open then return end
            local ap = container.AbsolutePosition
            popup.Position = UDim2.new(0, ap.X, 0, popup.Position.Y.Offset)
            popup.Size = UDim2.new(0, container.AbsoluteSize.X, 0, popup.Size.Y.Offset)
        end)
        task.delay(0.06, function()
            if not open then return end
            outsideConn = UserInputService.InputBegan:Connect(function(input, gp)
                if gp or not open then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mx, my = input.Position.X, input.Position.Y
                    local px, py = popup.AbsolutePosition.X, popup.AbsolutePosition.Y
                    local pw, ph = popup.AbsoluteSize.X, popup.AbsoluteSize.Y
                    local inside = mx >= px and mx <= px + pw and my >= py and my <= py + ph
                    local hx, hy = header.AbsolutePosition.X, header.AbsolutePosition.Y
                    local hw, hh = header.AbsoluteSize.X, header.AbsoluteSize.Y
                    local inHeader = mx >= hx and mx <= hx + hw and my >= hy and my <= hy + hh
                    if not inside and not inHeader then closePopup() end
                end
            end)
        end)
    end
    closePopup = function()
        if not open then return end
        open = false
        tween(popup, {Size = UDim2.new(0, popup.Size.X.Offset, 0, 0)}, 0.13); tween(chevron, {Rotation = 0}, 0.15)
        task.delay(0.15, function() if not open then popup.Visible = false end end)
        if renderConn then renderConn:Disconnect(); renderConn = nil end
        if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
    end
    closeBtn.MouseButton1Click:Connect(function() closePopup() end)
    header.MouseButton1Click:Connect(function() if open then closePopup() else openPopup() end end)
    table.insert(Library._activeDropdowns, closePopup)
    api = {
        Set = function(_, v, fire)
            value = v; selLabel.Text = tostring(v or "None"); Library.Flags[opts.Flag] = v
            refreshSelection(); if fire ~= false then callback(v) end
        end,
        Get = function() return value end,
        SetOptions = function(_, newOptions)
            options = newOptions
            if not value or not table.find(options, value) then value = options[1]; selLabel.Text = tostring(value or "None") end
            populate()
        end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = value; registerFlag(opts.Flag, function(v) api.Set(api, v, false) end) end
    return api
end

-- MULTI DROPDOWN
function Library:MultiDropdown(parent, opts)
    opts = opts or {}
    local options = opts.Options or {}
    local callback = opts.Callback or function() end
    local selected = {}
    if type(opts.Default) == "table" then for _, v in ipairs(opts.Default) do selected[v] = true end
    elseif opts.Default ~= nil then selected[opts.Default] = true end
    local function getList()
        local l = {}
        for _, opt in ipairs(options) do if selected[opt] then table.insert(l, opt) end end
        return l
    end
    local function getText()
        local l = getList()
        if #l == 0 then return opts.Placeholder or "None" end
        if #l == 1 then return l[1] end
        return #l .. " selected"
    end
    local open = false
    local renderConn, outsideConn
    local optData = {}
    local container = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
