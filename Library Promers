-- DROPDOWN
function Library:Dropdown(parent, opts)
    opts = opts or {}
    local options = opts.Options or {}
    local value = opts.Default or options[1]
    local cb = opts.Callback or function() end
    local open = false
    local renderConn, outsideConn
    local optData = {}

    local container = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(container, 6)
    local header = create("TextButton", {Parent = container, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false})
    create("TextLabel", {Parent = header, Size = UDim2.new(0.5, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Dropdown", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local selLabel = create("TextLabel", {Parent = header, Size = UDim2.new(0.5, -20, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, Text = tostring(value or "None"), TextColor3 = Library.Theme.Sub, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
    local popup, closeBtn = buildPopup(parent, opts.Text)
    local optionsArea = create("Frame", {Parent = popup, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 34), BackgroundTransparency = 1, ZIndex = 501})
    create("UIListLayout", {Parent = optionsArea, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder})
    create("UIPadding", {Parent = optionsArea, PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)})

    local contentHeight, totalHeight = 0, 0
    local function refreshHeights()
        local n = #options
        contentHeight = n * 28 + math.max(0, n - 1) * 2 + 12
        totalHeight = 33 + math.min(contentHeight, 240)
        optionsArea.Size = UDim2.new(1, 0, 0, math.min(contentHeight, 240))
    end
    local function refreshSel()
        for o, d in pairs(optData) do
            local sel = (o == value)
            d.btn.BackgroundColor3 = sel and Library.Theme.Bg3 or Library.Theme.Bg2
            d.lbl.TextColor3 = sel and Library.Theme.Text or Library.Theme.Sub
            d.lbl.Font = sel and Enum.Font.GothamBold or Enum.Font.Gotham
        end
    end
    local onSelect, closePopup
    local function populate()
        for _, c in ipairs(optionsArea:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        optData = {}
        for _, opt in ipairs(options) do
            local btn = create("TextButton", {Parent = optionsArea, Size = UDim2.new(1, -12, 0, 28), BackgroundColor3 = Library.Theme.Bg2, Text = "", AutoButtonColor = false, ZIndex = 502})
            corner(btn, 5)
            local lbl = create("TextLabel", {Parent = btn, Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = tostring(opt), TextColor3 = Library.Theme.Sub, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 503})
            btn.MouseEnter:Connect(function() if value ~= opt then tween(btn, {BackgroundColor3 = Library.Theme.Hover}, 0.1); tween(lbl, {TextColor3 = Library.Theme.Text}, 0.1) end end)
            btn.MouseLeave:Connect(function() if value ~= opt then tween(btn, {BackgroundColor3 = Library.Theme.Bg2}, 0.1); tween(lbl, {TextColor3 = Library.Theme.Sub}, 0.1) end end)
            btn.MouseButton1Click:Connect(function() onSelect(opt) end)
            optData[opt] = {btn = btn, lbl = lbl}
        end
        refreshHeights(); refreshSel()
    end
    onSelect = function(opt)
        value = opt; selLabel.Text = tostring(value); Library.Flags[opts.Flag] = value
        refreshSel(); if closePopup then closePopup() end; cb(value)
    end
    populate()

    local openPopup
    openPopup = function()
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        open = true; popup.Visible = true
        local ap, as = container.AbsolutePosition, container.AbsoluteSize
        local vy = workspace.CurrentCamera.ViewportSize.Y
        local y = ap.Y + as.Y + 4
        if y + totalHeight > vy - 10 then y = ap.Y - totalHeight - 4 end
        popup.Position = UDim2.new(0, ap.X, 0, y); popup.Size = UDim2.new(0, as.X, 0, 0)
        tween(popup, {Size = UDim2.new(0, as.X, 0, totalHeight)}, 0.18)
        renderConn = RunService.RenderStepped:Connect(function()
            if not open then return end
            local p = container.AbsolutePosition
            popup.Position = UDim2.new(0, p.X, 0, popup.Position.Y.Offset)
        end)
        task.delay(0.06, function()
            if not open then return end
            outsideConn = UserInputService.InputBegan:Connect(function(input, gp)
                if gp or not open then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mx, my = input.Position.X, input.Position.Y
                    local px, py = popup.AbsolutePosition.X, popup.AbsolutePosition.Y
                    local pw, ph = popup.AbsoluteSize.X, popup.AbsoluteSize.Y
                    local ins = mx >= px and mx <= px + pw and my >= py and my <= py + ph
                    local hx, hy = header.AbsolutePosition.X, header.AbsolutePosition.Y
                    local hw, hh = header.AbsoluteSize.X, header.AbsoluteSize.Y
                    local insH = mx >= hx and mx <= hx + hw and my >= hy and my <= hy + hh
                    if not ins and not insH then closePopup() end
                end
            end)
        end)
    end
    closePopup = function()
        if not open then return end
        open = false; tween(popup, {Size = UDim2.new(0, popup.Size.X.Offset, 0, 0)}, 0.13)
        task.delay(0.15, function() if not open then popup.Visible = false end end)
        if renderConn then renderConn:Disconnect(); renderConn = nil end
        if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
    end
    closeBtn.MouseButton1Click:Connect(function() closePopup() end)
    header.MouseButton1Click:Connect(function() if open then closePopup() else openPopup() end end)
    table.insert(Library._activeDropdowns, closePopup)

    local api = {
        Set = function(_, v, fire) value = v; selLabel.Text = tostring(v or "None"); Library.Flags[opts.Flag] = v; refreshSel(); if fire ~= false then cb(v) end end,
        Get = function() return value end,
        SetOptions = function(_, newOptions)
            options = newOptions or {}
            if #options == 0 then
                selLabel.Text = "(empty)"
                for _, c in ipairs(optionsArea:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
                optData = {}; refreshHeights(); return
            end
            if not value or not table.find(options, value) then value = options[1]; selLabel.Text = tostring(value) end
            populate()
        end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = value; registerFlag(opts.Flag, function(v) api.Set(api, v, false) end) end
    return api
end

-- MULTI DROPDOWN (same as before, shortened)
function Library:MultiDropdown(parent, opts)
    opts = opts or {}
    local options = opts.Options or {}
    local cb = opts.Callback or function() end
    local selected = {}
    if type(opts.Default) == "table" then for _, v in ipairs(opts.Default) do selected[v] = true end
    elseif opts.Default then selected[opts.Default] = true end
    local function getList() local l = {}; for _, o in ipairs(options) do if selected[o] then table.insert(l, o) end end; return l end
    local function getText() local l = getList(); if #l == 0 then return "None" end; if #l == 1 then return l[1] end; return #l .. " selected" end
    local open = false
    local renderConn, outsideConn
    local optData = {}
    local container = create("Frame", {Parent = parent, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Library.Theme.Bg3, BorderSizePixel = 0})
    corner(container, 6)
    local header = create("TextButton", {Parent = container, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = ""})
    create("TextLabel", {Parent = header, Size = UDim2.new(0.5, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = opts.Text or "Multi", TextColor3 = Library.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
    local selLabel = create("TextLabel", {Parent = header, Size = UDim2.new(0.5, -20, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, Text = getText(), TextColor3 = Library.Theme.Sub, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd})
    local popup, closeBtn = buildPopup(parent, opts.Text)
    local optionsArea = create("Frame", {Parent = popup, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 34), BackgroundTransparency = 1, ZIndex = 501})
    create("UIListLayout", {Parent = optionsArea, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder})
    create("UIPadding", {Parent = optionsArea, PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)})
    local ch = #options * 28 + math.max(0, #options - 1) * 2 + 12
    local th = 33 + math.min(ch, 240)
    optionsArea.Size = UDim2.new(1, 0, 0, math.min(ch, 240))
    for _, opt in ipairs(options) do
        local sel = selected[opt] == true
        local btn = create("TextButton", {Parent = optionsArea, Size = UDim2.new(1, -12, 0, 28), BackgroundColor3 = Library.Theme.Bg2, Text = "", AutoButtonColor = false, ZIndex = 502})
        corner(btn, 5)
        local mb = create("Frame", {Parent = btn, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 8, 0.5, -8), BackgroundColor3 = sel and Color3.fromRGB(255,255,255) or Library.Theme.Bg, BorderSizePixel = 0, ZIndex = 503})
        corner(mb, 4); stroke(mb, Library.Theme.Stroke, 1)
        local mc = create("TextLabel", {Parent = mb, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "✓", TextColor3 = Color3.fromRGB(20,20,20), Font = Enum.Font.GothamBold, TextSize = 11, TextTransparency = sel and 0 or 1, ZIndex = 504})
        local lbl = create("TextLabel", {Parent = btn, Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 32, 0, 0), BackgroundTransparency = 1, Text = tostring(opt), TextColor3 = sel and Library.Theme.Text or Library.Theme.Sub, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 503})
        btn.MouseButton1Click:Connect(function()
            selected[opt] = not selected[opt] or nil
            local s = selected[opt] == true
            mb.BackgroundColor3 = s and Color3.fromRGB(255,255,255) or Library.Theme.Bg
            mc.TextTransparency = s and 0 or 1
            lbl.TextColor3 = s and Library.Theme.Text or Library.Theme.Sub
            selLabel.Text = getText(); Library.Flags[opts.Flag] = getList(); cb(getList())
        end)
    end
    local openPopup, closePopup
    openPopup = function()
        for _, fn in ipairs(Library._activeDropdowns) do pcall(fn) end
        open = true; popup.Visible = true
        local ap, as = container.AbsolutePosition, container.AbsoluteSize
        local vy = workspace.CurrentCamera.ViewportSize.Y
        local y = ap.Y + as.Y + 4
        if y + th > vy - 10 then y = ap.Y - th - 4 end
        popup.Position = UDim2.new(0, ap.X, 0, y); popup.Size = UDim2.new(0, as.X, 0, 0)
        tween(popup, {Size = UDim2.new(0, as.X, 0, th)}, 0.18)
    end
    closePopup = function()
        if not open then return end
        open = false; tween(popup, {Size = UDim2.new(0, popup.Size.X.Offset, 0, 0)}, 0.13)
        task.delay(0.15, function() if not open then popup.Visible = false end end)
    end
    closeBtn.MouseButton1Click:Connect(function() closePopup() end)
    header.MouseButton1Click:Connect(function() if open then closePopup() else openPopup() end end)
    table.insert(Library._activeDropdowns, closePopup)
    local api = {
        Set = function(_, list, fire)
            selected = {}
            if type(list) == "table" then for _, v in ipairs(list) do selected[v] = true end end
            selLabel.Text = getText(); Library.Flags[opts.Flag] = getList()
            if fire ~= false then cb(getList()) end
        end,
        Get = function() return getList() end,
    }
    if opts.Flag then Library.Flags[opts.Flag] = getList(); registerFlag(opts.Flag, function(v) api.Set(api, v, false) end) end
    return api
end

